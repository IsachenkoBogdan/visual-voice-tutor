# App
APP_ENV=development
APP_NAME=visual-voice-tutor
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_AUTH_ENABLED=false
API_AUTH_TOKEN=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_API_KEY=

# Azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=ru-RU-DariyaNeural
AZURE_TTS_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3
AZURE_TTS_CHUNK_SIZE_BYTES=16384
AZURE_TTS_REQUEST_TIMEOUT_SEC=25
AZURE_ASR_LANGUAGE=ru-RU
AZURE_ASR_TIMEOUT_SEC=12

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Redis
REDIS_URL=redis://redis:6379/0

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# OpenTelemetry
OTEL_SERVICE_NAME=visual-voice-tutor-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Grafana / logs / traces
LOKI_URL=
TEMPO_OTLP_ENDPOINT=

# Future billing
BILLING_PROVIDER=
BILLING_API_KEY=
